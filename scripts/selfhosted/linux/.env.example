# 复制本文件为 .env 再填值（.env 已被 gitignore 忽略，不要提交）
cp .env.example .env

# ---- GitHub Repo ----
# 你的真实 repo：https://github.com/guocheng1378/apx-android
APXPC_GITHUB_OWNER=guocheng1378
REPO_URL=https://github.com/guocheng1378/apx-android

# ---- Runner Token ----
# 1 小时有效，从 https://github.com/<owner>/<repo>/settings/actions/runners/new 页面拿
# 容器重启时如果 token 已过期，用 refresh_token.py + GitHub PAT 自动刷（见下方）
RUNNER_TOKEN=paste_here

# ---- GitHub PAT（可选，长期用 refresh_token.py 自动刷 token 才需要）----
# 新建：https://github.com/settings/tokens → Generate new token → 选 Classic
# scope 只要 repo
GITHUB_PAT=paste_here_if_you_want_auto_refresh_token

# ---- Runner Labels / Name ----
# 多个 label 用逗号分隔，build.yml 的 runs-on 精确匹配这些 label
RUNNER_LABELS=apxpc-linux,x64,linux
RUNNER_NAME=apxpc-linux-fnnas

# ---- 时区 ----
TZ=Asia/Shanghai
