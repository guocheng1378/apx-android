<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · Android 端 Manifest
  namespace: com.allperiph
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wi‑Fi 控制通道（局域网 TCP + UDP 信标，见 wireless/TcpControlChannel.kt） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 蓝牙 HID -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 按键反馈震动（Feedback.tap → Vibrator） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 音频 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- GPS 上行（NmeaSource） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 触控与手写笔为可选硬件 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.stylus"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllPeriph"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="34">

        <!-- 主控制面：竖屏=触控板，横屏=全键盘 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AllPeriph">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 全屏触控板（纯竖屏） -->
        <activity
            android:name=".touchpad.TouchpadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen" />

        <!-- 全屏游戏手柄（横屏） -->
        <activity
            android:name=".ui.GamepadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen" />

        <!-- 文件面板：看「收到的文件」并转发给对端（与 TV 端同源交互） -->
        <activity
            android:name=".ui.FilePanelActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- 副屏全屏（Wi‑Fi 收流 + 硬解 + TextureView 渲染） -->
        <activity
            android:name=".screen.ScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen" />

        <!-- 前台服务 -->
        <service
            android:name=".ui.AgentForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 被控模式前台服务：使本机可被另一台手机控制（无需单独装 TV APK） -->
        <service
            android:name=".controlled.ControlledService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 系统级输入注入（被控模式）：本机作为被控设备驱动系统 -->
        <service
            android:name=".controlled.ApxAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <meta-data
            android:name="com.allperiph.NOTIFICATION_CHANNEL_STATUS"
            android:value="allperiph_status" />
    </application>

</manifest>
