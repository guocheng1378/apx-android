<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · AllPeriph Manifest
  namespace: com.allperiph
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Wi-Fi 状态（扫描 + 连接状态） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 粗略定位（Android 8.1+ Wi-Fi 扫描必需） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Wi-Fi Direct（P2P）—— 手机直连对端热点时需要。
      不需要位置权限；Manifest 声明即可。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      USB 权限：插线后弹授权弹窗；
      FOREGROUND_SERVICE 保证后台服务不被杀；
      SYSTEM_ALERT_WINDOW：Toast overlay（fallback 用）
    -->

    <!--
      HID 需要 BLUETOOTH_CONNECT（API 31+）和 ACCESS_FINE_LOCATION（扫描）。
      AndroidManifest 声明即可，运行时权限在 BtHidDevice.start() 中检查。
    -->

    <!--
      Wi-Fi 控制：读/写系统设置（锁定/解锁 AP 限制）
    -->

    <!--
      Wi-Fi 控制：需要 ACCESS_FINE_LOCATION + ACCESS_WIFI_STATE
      （Android 10+ 的 Location Services 要求同时声明）
    -->

    <!--
      HID 需要 BLUETOOTH_CONNECT（API 31+）；
      ACCESS_FINE_LOCATION 用于经典蓝牙扫描。
    -->

    <!--
      Wi-Fi 控制（设置固定 AP 限制）：
      ACCESS_WIFI_STATE + WRITE_SETTINGS + CHANGE_WIFI_STATE
    -->

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllPeriph">

        <!--
          ① 主控制面（竖屏，v1.19）。
          结构：顶栏（复用块 header_bar）+ 四页 ViewFlipper + MIUIX 液态悬浮底栏（复用块 nav_tabs）。
          横屏布局见 res/layout-land/activity_main.xml（沉浸操控面）。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AllPeriph">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ② 触控板（手势捕捉面，v1.19）
          结构：全屏手势区域 + 右侧快捷键网格（复用块 shortcuts_grid）。
          横屏布局见 res/layout-land/activity_touchpad.xml（手势区域拉宽）。
        -->
        <activity
            android:name=".ui.TouchpadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph.Mini.Fullscreen" />

        <!--
          ③ 远程输入（键盘+遥控，v1.19）
          结构：顶栏（遥控器模式切换）+ 键盘区域 + 功能键区。
          横屏布局见 res/layout-land/activity_remote.xml（横屏双栏：左键盘/右功能键）。
        -->
        <activity
            android:name=".ui.RemoteActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:theme="@style/Theme.AllPeriph.Mini" />

        <!--
          ④ 游戏手柄（双摇杆，v1.19）
          结构：底栏（十字键/摇杆切换）+ 摇杆区域 + 功能键区。
          横屏布局见 res/layout-land/activity_gamepad.xml（沉浸全屏）。
        -->
        <activity
            android:name=".ui.GamepadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph.Mini.Fullscreen" />

        <!--
          ⑤ 文件传输面板（遥控器友好，v1.19）
          结构：顶栏（目标设备切换）+ 文件列表 + 底栏（发送按钮）。
          横屏布局见 res/layout-land/activity_file_panel.xml（双栏：左列表/右操作）。
        -->
        <activity
            android:name=".ui.FilePanelActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph.Mini" />

        <!--
          ⑥ 后台服务（v1.19）：启动前台通知，保留 Binder 保活。
        -->
        <service
            android:name=".ui.AgentForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          ⑦ HID 绑定（v1.19）：被电脑绑定后弹授权弹窗。
        -->
        <service
            android:name=".controlled.ControlledService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          ⑧ IME（v1.19）：远程输入用标准 InputMethod，
          免去 Accessibility 的兼容性坑（真机验证：小米 Android 11/13）。
        -->
        <service
            android:name=".shared.im.AppxImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime_method" />
        </service>

        <!--
          ⑨ 无障碍（v1.19）：备用输入通道，
          被电脑绑定后自动引导用户开启。
        -->
        <service
            android:name=".shared.accessibility.AppxAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!--
          ⑩ 快捷设置 Tile：下拉通知栏快速开关
        -->
        <service
            android:name=".ui.AllPeriphTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="全能外设"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          ⑪ 遥控输入：全屏 Activity（覆盖在其他应用之上）
          由被控端设备点击通知启动，用于接收远程键盘输入
        -->
        <activity
            android:name=".controlled.RemoteInputActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:theme="@style/Theme.AllPeriph.Mini.Fullscreen"
            android:taskAffinity=".controlled.RemoteInputActivity"
            android:excludeFromRecents="true"
            android:documentLaunchMode="always" />

        <!--
          ⑫ 连接状态通知：接收端弹出通知，点击可启动 RemoteInputActivity
          v1.71: 共用 RemoteInputActivity，点击通知直接进入远程输入界面
        -->
        <receiver
            android:name=".controlled.ConnectNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          ⑬ 保活闹钟：每天 03:25 检查服务是否存活，不存活则重启
          v1.76: 6 天一次（周二/周五），配合 WorkManager 双保险
        -->
        <receiver
            android:name=".ui.KeepAliveReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.allperiph.KEEP_ALIVE" />
            </intent-filter>
        </receiver>

        <!--
          ⑭ 外部应用启动入口（v1.76）
          其他 App 可通过 ACTION_SEND 发送文本到全能外设：
            am start -a android.intent.action.SEND -t text/plain --es android.intent.extra.TEXT "内容"
          全能外设收到后，自动将文本转为键盘输入发送到受控设备。
          适用于：输入法快捷短语、语音识别文本中转等场景。
        -->
        <activity
            android:name=".ui.ExternalSendActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          ⑮ 全能外设控制页快捷入口（v1.84）
          从系统设置、桌面长按图标等处直接跳到控制页
        -->
        <activity
            android:name=".ui.ControlShortcutActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph">
            <intent-filter>
                <action android:name="com.allperiph.OPEN_CONTROL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          ⑯ 启动引导页（v1.88）：首次启动展示使用引导
        -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AllPeriph" />

        <meta-data
            android:name="com.allperiph.NOTIFICATION_CHANNEL_STATUS"
            android:value="allipherphstatus" />

    </application>
</manifest>
