<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · Android 端 Manifest
  namespace: com.allperiph
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 网络（TCP 传输 + 无线配对） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 传感器 -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- GPS NMEA -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 蓝牙 HID -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 音频 UAC2 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AOA 附件模式 -->
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />
    <!-- 触控与手写笔 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />
    <uses-feature android:name="android.hardware.stylus" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllPeriph"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="34">

        <!-- 主控制面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:configChanges="keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 触控板 -->
        <activity
            android:name=".touchpad.TouchpadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen" />

        <!-- 前台服务 -->
        <service
            android:name=".ui.AgentForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <meta-data
            android:name="com.allperiph.NOTIFICATION_CHANNEL_STATUS"
            android:value="allperiph_status" />
    </application>

</manifest>
