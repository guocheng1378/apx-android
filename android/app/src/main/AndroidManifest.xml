<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · AllPeriph Manifest
  namespace: com.allperiph
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      手机文件浏览（2026-11-11「文件管理」方向三，0x44–0x47）：电脑浏览/取走手机公共目录的
      文件需要「所有文件访问」。只在收到 0x44/0x46 时读取公共目录；不授予则 PC 端如实提示
      （PhoneFiles 回 ERR_NO_PERM），应用私有目录（接收文件的 APX 目录）不受影响。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!--
      悬浮球「最新照片卡片」（ROADMAP §5.2 ①，2026-11-12）：读系统相册最新一张（MediaStore）
      需要「照片和视频」分媒体权限。运行时申请走独立透明页 PhotoPermActivity（Service 不能弹权限框）。
      minSdk 34，无 32- 的 READ_EXTERNAL_STORAGE 分支。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- v223.29：悬浮球自愈需要「开机广播」——手机重启后按用户意愿位把球放回屏幕 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      震动反馈：触控板长按锁定拖拽时的触觉提示、副屏交互反馈都用到。
      ⚠️ v196 之前没声明 —— Vibrator.vibrate() 是普通权限但**必须声明**才可用，
      缺失时调用抛 SecurityException（真机：长按拖拽没有震动反馈）。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wi-Fi 状态（扫描 + 连接状态） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 粗略定位（Android 8.1+ Wi-Fi 扫描必需） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Wi-Fi Direct（P2P）—— 手机直连对端热点时需要。
      不需要位置权限；Manifest 声明即可。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      USB 权限：插线后弹授权弹窗；
      FOREGROUND_SERVICE 保证后台服务不被杀；
      SYSTEM_ALERT_WINDOW：Toast overlay（fallback 用）
    -->

    <!--
      蓝牙 HID：
      · BLUETOOTH_CONNECT —— API 31+ 必需，BtHidDevice.start() 里 checkSelfPermission 判定
      · ACCESS_FINE_LOCATION —— 经典蓝牙扫描（Android 10+ 同时要求）
      ⚠️ v196 之前这里**只有注释、没有声明语句**：checkSelfPermission 对未声明权限恒为 DENIED，
      蓝牙 HID 在所有 Android 12+ 设备上直接降级不可用（最难排查的一类静默失效）。
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      麦克风上行（手机麦克风 → PC 的麦克风）。
      ⚠️ v196 之前同样只有注释没有声明 —— MainActivity.ensureNotificationPermission() 会申请它，
      但未声明的权限申请会立即回调 denied，录音功能永远不可用。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      摄像头上行（M7-b，手机摄像头 → PC，streamId=6 JPEG）。
      与 RECORD_AUDIO 同一条教训：声明是运行时授权的前提 —— 未声明时
      CameraPushActivity 的 requestPermissions 立即回调 denied，推流永远起不来。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      屏幕采集（投屏到电脑）：Android 14+ 要求 mediaProjection 类型前台服务
      必须声明该权限，否则 startForeground 直接抛异常，采集起不来。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      悬浮窗：被控模式（手机当被控端）显示对方光标落点，用的是 TYPE_APPLICATION_OVERLAY。
      ⚠️ v196 之前只有注释「SYSTEM_ALERT_WINDOW：Toast overlay（fallback 用）」，没有声明 ——
      TvOverlay 创建浮层抛 SecurityException 又被 try/catch 吞掉，结果是
      **被控模式下永远看不到光标可视化**，日志只有一行「被控浮层 创建失败」。
      SYSTEM_ALERT_WINDOW 是特殊权限：声明后仍需用户在系统设置里手动授权
      （应用内已由 TouchpadActivity 的「开启悬浮窗」入口引导）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      电池白名单申请：MainActivity 用ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
      拉起系统弹窗，未声明时 runCatching 吞掉异常并降级到"自己去找设置列表"，
      用户点「加入白名单」永远没反应。tv 模块早就声明了，app 漏了。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- LocalSend 互传：UDP 多播需 MulticastLock，否则 Wi-Fi 省电丢 announce -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- LocalSend 接收前台服务（Android 14+ dataSync 类型必需） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Wi-Fi 控制：读/写系统设置（锁定/解锁 AP 限制）
    -->

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllPeriph"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic：LocalSend 协议按官方口径就是局域网明文 HTTP（http://ip:53317）。
             targetSdk ≥ 28 时平台默认禁明文出站 —— 此前没开这一位，手机端所有出站 HTTP
             （postRegister 单播应答、发送三步 register/prepare/upload）在 HttpURLConnection
             处直接抛「Cleartext HTTP traffic not permitted」，表现为发现通路半残、发送必挂；
             被动侧（接收文件，对方连本机 server）不受该策略影响，所以「收得到、发不出」。
             仅本 App 需要明文，按官方协议放开（零凭据零隐私数据，无安全边界问题）。 -->

        <!--
          ① 主控制面（竖屏，v1.19）。
          结构：顶栏（复用块 header_bar）+ 四页 ViewFlipper + MIUIX 液态悬浮底栏（复用块 nav_tabs）。
          **只有这个 Activity 真有 layout-land/activity_main.xml**（横屏沉浸操控面 +
          右上角操作条 pill）；其余页面的横屏适配都在代码里做（运行时重排），
          写在这里是为了以后别再去找不存在的布局文件。
        -->

        <!--
          状态页迁移宿主（阶段 2）：Compose + Miuix 重写的状态页，并行于旧主界面。
          没有 LAUNCHER，只能从组件总览/调试入口进入；全部屏迁完后才把主入口切到这里，
          切换与回退都只涉及这一处。
        -->
        <!--
          ⚠️ 本页刻意不写 android:screenOrientation —— 2026-11-02 真机踩过两次，写清楚谁决定朝向：
          1) 属性写死成 "sensor" 是错的：清单是静态声明，改不动；
          2) 但**只删掉属性并不等于跟随用户旋转锁** —— 运行期 [com.allperiph.ui.OrientLock.apply]
             会在 onCreate/onResume 里按偏好重设 requestedOrientation，
             关锁时它显式设 SCREEN_ORIENTATION_SENSOR（"App 自己决定"，与"重力判读自动切页"
             互为配套：版式跟着重力转，页面才跟着重力切）；开锁时设 LOCKED（钉在当前朝向）。
             也就是说**朝向的真实决定权在 OrientLock，不在本清单**，别看到这里空着就以为
             user_rotation 能生效 —— 真机验证前先确认设置页的「方向锁定」开关状态。
          3) 「横屏切换后会先跳状态页再跳回」的修法与本属性无关：靠 configChanges（旋转不重建
             Activity）+ ApShellActivity.onSaveInstanceState 的页签存档两层兜住。
          ⚠️ 另外：XML 注释不能写在开始标签的属性之间，只能整段放在元素外面（第一版就是
             写进 <activity> 属性里，CI 在 processReleaseMainManifest 报
             "Error parsing AndroidManifest.xml"，整轮判死）。
        -->
        <activity
            android:name=".ui.compose.ApShellActivity"
            android:label="全能外设"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ② 触控板（手势捕捉面，v1.19）
          结构：全屏手势区域 + 右侧快捷键网格。
          横屏没有单独布局 —— 分栏由 TouchpadSplit 在运行时重排（旋屏不重建 Activity）。
        -->
        <activity
            android:name="com.allperiph.touchpad.TouchpadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen" />

        <!--
          ②之二 副屏（PC 画面推到手机）：v196 补注册。
          ⚠️ 之前 manifest 完全没有这个 Activity —— 类是存在的，但没注册就不能被
          startActivity 启动（与混淆无关，minify 关着也一样）。后果：点「副屏」=
          ActivityNotFoundException 直接闪退（真机 21:11 复现）；前台通知的
          「副屏」动作按钮同理。
        -->
        <activity
            android:name="com.allperiph.screen.ScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen"
            android:excludeFromRecents="true" />

        <!--
          ③ 远程输入（键盘+遥控，v1.19）
          结构：顶栏（遥控器模式切换）+ 键盘区域 + 功能键区。
          横屏没有单独布局，键盘面板按可用宽度自适应。
        -->
        <activity
            android:name=".ui.RemoteActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:theme="@style/Theme.AllPeriph.Miuix" />

        <!--
          ④ 游戏手柄（双摇杆，v1.19）
          结构：双摇杆 + A/B/X/Y + 肩键；UI 全部由代码构建，没有对应的 layout 文件。
          坐标按 **800×360dp 横屏**核算（见 GamepadActivity 里 setMargins 的注释），
          所以强制横屏 —— 此前写的 sensor，竖屏进来时那套坐标会挤成一团。
        -->
        <activity
            android:name=".ui.GamepadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen" />

        <!--
          ⑤ 文件传输面板（遥控器友好，v1.19）
          结构：顶栏（目标设备切换）+ 文件列表 + 底栏（发送按钮）。
          横屏没有单独布局，UI 由 FilePanelActivity 代码构建、随宽度自适应。
        -->
        <activity
            android:name=".ui.FilePanelActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph.Miuix" />

        <!--
          ⑥ 后台服务（v1.19）：启动前台通知，保留 Binder 保活。
        -->
        <service
            android:name=".ui.AgentForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 反馈#7：悬浮球 —— 独立 overlay 触控板窗口（HyperOS 小窗失焦不派发输入的绕行） -->
        <service
            android:name=".ui.FloatingBallService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- LocalSend 互传接收（issue#45 MVP1）：UDP 发现 + HTTP 接收，落 Download/LocalSend -->
        <service
            android:name=".localsend.LocalSendService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- LocalSend 发送页（issue#45 MVP2） -->
        <activity
            android:name=".localsend.SendActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:label="LocalSend 发送" />

        <!--
          ⑦ HID 绑定（v1.19）：被电脑绑定后弹授权弹窗。
        -->
        <service
            android:name=".controlled.ControlledService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          ⑧ IME（v1.19）：远程输入用标准 InputMethod，
          免去 Accessibility 的兼容性坑（真机验证：小米 Android 11/13）。
          ⚠️ v196 之前这里写的是 `.shared.im.AppxImeService` —— 包名少个e、类名多一个 p，
          系统找不到该类：**输入法根本不会被注册**（远程输入中文上不了屏）。
        -->
        <service
            android:name=".shared.ime.ApxImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime_method" />
        </service>

        <!--
          ⑨ 无障碍（v1.19）：备用输入通道，
          被电脑绑定后自动引导用户开启。
          ⚠️ 同上：原类名写成 AppxAccessibilityService（多一个 p），服务不会被加载。
        -->
        <service
            android:name=".shared.accessibility.ApxAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          ⑨之二 通知同步（2026-11-11）：通知使用权监听，手机通知 → PC 托盘气泡（0x40/0x42）。
          双开关：应用内偏好默认关（NotificationSyncPref）+ 系统「通知使用权」授权；
          未打开偏好时监听即使被绑定也立即返回，通知不出本机。
        -->
        <service
            android:name=".notify.ApxNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          ⑩ 快捷设置 Tile：下拉通知栏快速开关
        -->
        <service
            android:name=".ui.AllPeriphTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_app"
            android:label="全能外设"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          ⑩之二 桌面小组件：显示连接状态。
          ⚠️ v196 之前 AllPeriphWidget 类写好了却**没注册**（也没有 xml/widget_all_periph_info.xml），
          启动器里根本找不到它 —— 小组件功能等于不存在。
        -->
        <receiver
            android:name=".ui.AllPeriphWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_all_periph_info" />
        </receiver>

        <!--
          文件面板「打开 / 分享」（2026-11-11「文件管理」第一批）：把收到的文件以 content://
          临时授权给相册 / 播放器 / 分享目标。与 TV 端 .ui.ApxFileProvider 同构（各自一份），
          不得传 file://（targetSdk ≥ 24 会抛 FileUriExposedException，见类头注释）。
        -->
        <provider
            android:name=".ui.ApxFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          ⑪ 遥控输入：全屏 Activity（覆盖在其他应用之上）
          由被控端设备点击通知启动，用于接收远程键盘输入
        -->
        <activity
            android:name=".controlled.RemoteInputActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen"
            android:taskAffinity=".controlled.RemoteInputActivity"
            android:excludeFromRecents="true"
            android:documentLaunchMode="always" />

        <!--
          ⑪之二 多设备接入确认（v223.33）：两台及以上设备连入被控服务时，
          ControlServer 不再静默接管（旧行为：第二台顶掉第一台，两边自动重连
          互相踢 = "两台设备打架"），拉起本页弹窗，用户点「确定」才切换。
          透明主题只为承载系统弹窗；singleTop 防并发接入时叠多层。
        -->
        <activity
            android:name=".controlled.TakeoverDialogActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          ⑪之三 「照片」媒体权限申请页（2026-11-12，ROADMAP §5.2 ①）：悬浮球照片卡在
          Service（overlay）里构建，运行时权限只能由 Activity 发起 —— 透明主题只承载
          系统弹窗，进来就申请、拿到结果即 finish。singleTop 防连点叠多层。
        -->
        <activity
            android:name=".ui.PhotoPermActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          ⑪之六 相册多选页（2026-11-11，issue#168 二轮）：悬浮球照片卡改「点选 → 再点发」，
          点卡拉系统多选 —— Service overlay 里没有 Activity 宿主，透明页进来就拉
          GetMultipleContents、结果投回 BallLatestPhoto.onPicked 即 finish。
          singleTop 防连点叠多层（同 PhotoPermActivity）。
        -->
        <activity
            android:name=".ui.PhotoPickActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          ⑪之四 「语音」工具键识别宿主页（2026-11-11）：系统语音识别要 Activity 宿主，
          悬浮键盘（Service overlay）里的语音键没有宿主 —— 透明页进来就拉识别、
          结果经伴生回调投回面板、即 finish。singleTop 防连点叠多层（同 PhotoPermActivity）。
        -->
        <activity
            android:name=".ui.VoiceCaptureActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          ⑫ 连接状态通知点击 → RemoteInputActivity
          v196 起改为由ControlledService 直接发 RemoteInputActivity 的 PendingIntent，
          原 .controlled.ConnectNotificationReceiver 这个类**并不存在**（注册是悬空的），
          故不再注册。需要"点通知进输入页"时用 PendingIntent 指向 RemoteInputActivity 即可。
        -->

        <!--
          ⑬ 保活闹钟：每天 03:25 检查服务是否存活，不存活则重启
          v1.76: 6 天一次（周二/周五），配合 WorkManager 双保险
          ⚠️ v196 之前这里写的是 `.ui.KeepAliveReceiver` —— 真类在 shared.inject 包
          （com.allperiph.shared.inject.KeepAliveReceiver，shared 模块抽取时挪的包）。
          注册名指向不存在的类 → 闹钟广播被系统静默丢弃，**保活闭环完全失效**（不崩但拉不回服务）。
        -->
        <receiver
            android:name=".shared.inject.KeepAliveReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.allperiph.KEEP_ALIVE" />
            </intent-filter>
        </receiver>

        <!--
          ⑰ 悬浮球自愈（v223.29）：修成宇 2026-11-02「悬浮窗不会自动拉起」。

          为什么不复用上面那条 KeepAliveReceiver：那条链路的 cancel 语义绑在「用户主动关掉
          被控服务」上，一旦复用，用户关掉被控就会顺带把悬浮球的自检也停掉 —— 而这两件事
          彼此无关（球可以开着，被控关着）。所以单独一份，只认「用户意愿位」这一个开关。

          为什么必须落成清单里的显式组件：闹钟的杀手锏就是「进程被杀后系统重新拉起一个全新
          进程来投递广播」，新进程里没有任何自己的代码跑过 —— 只有清单注册的接收者能被唤起。
          receiver 都是 exported=false（只由本应用自己的 PendingIntent / 系统开机广播触发）。
        -->
        <receiver
            android:name=".ui.FloatingBallKeepAliveReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.allperiph.BALL_KEEP_ALIVE" />
            </intent-filter>
        </receiver>

        <!-- 手机重启 / 应用更新后按意愿位把球放回屏幕（同上：只认用户开过的那一档） -->
        <receiver
            android:name=".ui.FloatingBallBootReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>


        <!--
          ⑭ 外部应用启动入口（v1.76）：⚠️ 已暂停注册。
          原本注册了 .ui.ExternalSendActivity（接收 ACTION_SEND 文本并转发到被控设备），
          但**该类从未实现** —— 注册悬空会让外部 intent 抛 ActivityNotFound。
          实现计划：读 extra「android.intent.extra.TEXT」→ 若已连接则走
          ControlTarget.sendText（与 TvControlServer 的输入通道一致）→ 结束自身。
        -->

        <!--
          ⑮ 全能外设控制页快捷入口（v1.84，v196 补实现）
          Tile 点击 / 外部 OPEN_CONTROL intent 都经这里转到 MainActivity（自身立即 finish）
        -->
        <activity
            android:name=".ui.ControlShortcutActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AllPeriph">
            <intent-filter>
                <action android:name="com.allperiph.OPEN_CONTROL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          ⑮之二 摄像头推流页（M7-b，docs/spikes/m7-media-inbound-spike.md §2.3）。
          手机摄像头 → MediaOut.camera()（streamId=6，JPEG 720p q80 ≈10fps）。
          当前无应用内入口（M7-c 面板接），先 adb 拉起：
            adb shell am start -n com.allperiph/.camera.CameraPushActivity
          刻意不写 screenOrientation：预览竖横屏自适应，朝向交给系统。
        -->
        <activity
            android:name=".camera.CameraPushActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix.Fullscreen"
            android:excludeFromRecents="true" />

        <!--
          ⑮之三 投屏到电脑（屏幕采集）：授权页 + 前台采集服务。
          采集页弹系统投屏授权，成功后起 mediaProjection 类型前台服务；
          画面经 MediaOut.camera() 复用 streamId=6 上行，PC 预览窗与摄像头共用。
          ⚠️ Android 14+：FOREGROUND_SERVICE_MEDIA_PROJECTION 权限未声明时
          startForeground 直接抛异常，采集起不来。
        -->
        <activity
            android:name=".screenmirror.ScreenMirrorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:theme="@style/Theme.AllPeriph.Miuix"
            android:excludeFromRecents="true" />

        <service
            android:name=".screenmirror.ScreenMirrorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          ⑯ 启动引导页（v1.88）：⚠️ 已暂停注册 ——
          OnboardingActivity 这个类并不存在（v196 之前是悬空注册）。
          真要做首次启动引导时再实现并注册；在此之前宁可不注册。
        -->

        <meta-data
            android:name="com.allperiph.NOTIFICATION_CHANNEL_STATUS"
            android:value="allipherphstatus" />

    </application>
</manifest>
