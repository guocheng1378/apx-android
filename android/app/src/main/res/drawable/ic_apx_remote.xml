<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷项图标：遥控器（机身 + 按点）
     单色遮罩（strokeColor 固定 #FF000000），实际颜色由使用处 tint 决定。
     口径与 ic_apx_* 家族一致：24 视口、描边 1.7、圆角圆头。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 机身：竖圆角矩形 -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8,2.8 h8 a1.6,1.6 0 0 1 1.6,1.6 v15.2 a1.6,1.6 0 0 1 -1.6,1.6 h-8 a1.6,1.6 0 0 1 -1.6,-1.6 v-15.2 a1.6,1.6 0 0 1 1.6,-1.6 z" />
    <!-- 主按键：顶部圆点 -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M12,7.4 v0.01" />
    <!-- 次按键：两颗小点 -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M10,11.6 v0.01" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M14,11.6 v0.01" />
</vector>
