<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮球本体（v223.15 改 MIUI / HyperOS 快捷球风格）。
  形态：48dp 半透明圆 + 一圈极淡外沿柔光（layer-list 模拟投影 —— overlay 窗口
  没有父容器，elevation 不会画阴影）。
  配色全部走 ball_* 令牌，深浅两套由 values-night 覆盖，这个文件不用改。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外沿柔光：比球身大一圈、透明度更低，远看像一层淡淡的投影 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ball_halo" />
        </shape>
    </item>
    <!-- 球身：仿玻璃 —— 上亮下暗的线性渐变 + 1dp 外沿描边。
         overlay 窗口拿不到下层画面，真模糊（Haze / RuntimeShader）在这里无效，
         所以用「渐变 + 高光 + 柔光」三件套近似玻璃质感。 -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="@color/ball_glass_bottom"
                android:startColor="@color/ball_glass_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/ball_stroke" />
        </shape>
    </item>
    <!-- 顶部高光：偏心小球，模拟玻璃的反光点（inset 把它压到球体上部） -->
    <item
        android:bottom="20dp"
        android:left="10dp"
        android:right="18dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/ball_glass_hi" />
        </shape>
    </item>
</layer-list>
