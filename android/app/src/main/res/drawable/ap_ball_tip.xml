<?xml version="1.0" encoding="utf-8"?>
<!--
  球旁浮动提示的底（issue#169 #5 追评）：与球体同一套仿玻璃渐变（ball_glass_*），
  圆角矩形 12dp —— 不用 bg_ball_item 是因为它带按下态 selector，
  提示不参与点击，套 selector 只是白费一层状态。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/ball_glass_bottom"
        android:startColor="@color/ball_glass_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/ball_stroke" />
    <corners android:radius="12dp" />
</shape>
