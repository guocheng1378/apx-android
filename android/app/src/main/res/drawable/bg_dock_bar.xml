<?xml version="1.0" encoding="utf-8"?>
<!--
  服务层悬浮栏底图（issue#168 2026-11-10 22:46「4 个页面为悬浮栏展开菜单样式」）。
  形态：横玻璃胶囊（与壳内低栏同观感），配 ball_* 令牌走深浅两套主题。
  overlay 窗口没有父容器，elevation 画不了阴影 —— 1dp 描边给轮廓感（同悬浮球底图口径）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ball_solid" />
    <stroke
        android:width="1dp"
        android:color="@color/ball_stroke" />
    <corners android:radius="26dp" />
</shape>
