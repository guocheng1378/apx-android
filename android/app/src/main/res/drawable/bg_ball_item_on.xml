<?xml version="1.0" encoding="utf-8"?>
<!--
  扇形菜单里「已开启」的连接模式快捷项（v223.15）。
  与 bg_ball_item 常态同尺寸同形状，只把填充换成主色实底 —— 展开时一眼能看出
  无线／蓝牙／USB 哪一路是开着的，不用点进去看状态页。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/apPrimary" />
    <stroke
        android:width="1dp"
        android:color="?attr/apPrimary" />
</shape>
