<?xml version="1.0" encoding="utf-8"?>
<!--
  MIUIX 深色主题：与 values/themes.xml 同名覆盖。
  与亮色的差异只有「系统栏描边方向」和「对话框父类」——颜色本身仍引用同一套
  @color/md_* 令牌（值由 values-night/colors.xml 提供）。
-->
<resources>

    <style name="Theme.AllPeriph" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="apPrimary">@color/md_primary</item>
        <item name="apPrimaryPressed">@color/md_primary_pressed</item>
        <item name="apPrimaryContainer">@color/md_primary_container</item>
        <item name="apOnPrimary">@color/md_on_primary</item>
        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.AllPeriph.Miuix" parent="Theme.AllPeriph" />

    <style name="Theme.AllPeriph.Miuix.Fullscreen" parent="Theme.AllPeriph.Miuix">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.AllPeriph.Miuix.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="apPrimary">@color/md_primary</item>
        <item name="apPrimaryPressed">@color/md_primary_pressed</item>
        <item name="apPrimaryContainer">@color/md_primary_container</item>
        <item name="apOnPrimary">@color/md_on_primary</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:windowBackground">@color/md_surface</item>
    </style>

    <!--
      对话框的莫奈变体（建议 3）：AlertDialog.Builder(ctx, themeRes) 拿到的是「从资源新建」的
      主题，不会继承 Activity 上已叠加的 APMonetOverlay，所以这里单开一个变体，
      由 ThemeSkin.dialogStyle() 按开关挑。
    -->
    <style name="Theme.AllPeriph.Miuix.Dialog.Monet" parent="Theme.AllPeriph.Miuix.Dialog">
        <item name="apPrimary">@android:color/system_accent1_200</item>
        <item name="apPrimaryPressed">@android:color/system_accent1_300</item>
        <item name="apPrimaryContainer">@android:color/system_accent1_700</item>
        <item name="apOnPrimary">@android:color/system_accent1_800</item>
        <item name="android:colorAccent">@android:color/system_accent1_200</item>
    </style>
</resources>
