<?xml version="1.0" encoding="utf-8"?>
<!--
  MIUIX / HyperOS 深色取值（v1.16）。
  与 values/colors.xml 同名同义 —— 主题方案切到「深色」或系统进入夜间时，
  下面这些值自动覆盖，布局 / 样式 / drawable 一律不用改。
-->
<resources>
    <color name="md_primary">#FF4C93FF</color>
    <color name="md_on_primary">#FFFFFFFF</color>
    <color name="md_primary_container">#FF1B3A6B</color>
    <color name="md_primary_pressed">#FF3D7FE0</color>

    <color name="md_error_container">#FF4A1A16</color>

    <color name="md_background">#FF000000</color>
    <color name="md_on_background">#FFEDEDED</color>
    <color name="md_surface">#FF1C1C1E</color>
    <color name="md_on_surface">#FFEDEDED</color>
    <color name="md_surface_variant">#FF2C2C2E</color>
    <color name="md_on_surface_variant">#FF9BA1A6</color>
    <color name="md_outline">#FF2C2C2E</color>

    <color name="state_ok">#FF34C77B</color>
    <color name="state_warn">#FFF7B45C</color>
    <color name="state_error">#FFF97066</color>
    <color name="state_idle">#FF7C848C</color>

    <color name="card_stroke">#FF2C2C2E</color>
    <color name="badge_bg">#FF1B3A6B</color>

    <!-- MIUIX 液态玻璃底栏（深色：半透明白玻璃，与浅色主题镜像） -->
    <!-- 选中胶囊：玻璃主体 / 高光 / 边缘亮线 / 外圈柔光 / 底部内阴影 -->
    <color name="nav_pill">#2EFFFFFF</color>
    <color name="nav_pill_shine">#3DFFFFFF</color>
    <color name="nav_pill_stroke">#29FFFFFF</color>
    <color name="nav_pill_halo">#1FFFFFFF</color>
    <color name="nav_pill_shade">#33000000</color>

    <color name="miuix_bg">@color/md_background</color>
    <color name="miuix_card">@color/md_surface</color>
    <color name="miuix_text">@color/md_on_background</color>
    <color name="miuix_text_secondary">@color/md_on_surface_variant</color>
    <color name="miuix_text_tertiary">#FF6B7075</color>
    <color name="miuix_divider">@color/md_outline</color>
    <color name="miuix_stroke">@color/card_stroke</color>
    <color name="miuix_accent">@color/md_primary</color>
    <color name="miuix_accent_soft">@color/md_primary_container</color>
    <color name="miuix_danger">@color/state_error</color>

    <!-- 语义红：深色底下要提亮，否则白卡换深卡后 #B3261E 对比不足 -->
    <color name="md_error">#FFF2B8B5</color>

    <!-- 色点描边：深色底下改用亮描边（原来固定深色，深色主题里看不出选中环） -->
    <color name="dot_stroke_selected">#FFEDEDED</color>
    <color name="dot_stroke_normal">#33FFFFFF</color>

    <!-- 悬浮球：深色下换成深底白点，跟其余页面同一套令牌 -->
    <color name="ball_bg">#F21C1C1E</color>
    <color name="ball_text">#FFEDEDED</color>
    <color name="ball_stroke">#33FFFFFF</color>
    <!-- v223.15 MIUI 快捷球：深色下的外沿柔光（黑底上投影看不见，改用淡白） -->
    <color name="ball_halo">#1FFFFFFF</color>

    <!--
      快捷键模板色板（vXXX）深色覆盖：终端石墨 #5B6470 与表格墨绿 #1E9E5A
      在深色底上偏暗（做标题与芯片文字会糊进背景），这里换成同色系的可读值。
    -->
    <color name="hotkey_tpl_term">#FFAEB6C2</color>
    <color name="hotkey_tpl_sheet">#FF35C98A</color>

</resources>
