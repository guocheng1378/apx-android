<?xml version="1.0" encoding="utf-8"?>
<!--
  MIUIX / HyperOS 深色取值（v1.16）。
  与 values/colors.xml 同名同义 —— 主题方案切到「深色」或系统进入夜间时，
  下面这些值自动覆盖，布局 / 样式 / drawable 一律不用改。

  2026-11-09 界面稿「08 质感层」：暗色不用阴影堆叠，改 3 级亮度：
  底 #15181E / 卡 #1E232B / 内嵌 #141920，边框白色 8%（#14FFFFFF）。
-->
<resources>
    <!-- 强调色与亮色同值 #3482FF，按下态取稿子里的 accent2 #5B9BFF -->
    <color name="md_primary">#FF3482FF</color>
    <color name="md_on_primary">#FFFFFFFF</color>
    <color name="md_primary_container">#FF142745</color>
    <color name="md_primary_pressed">#FF5B9BFF</color>

    <color name="md_error_container">#FF4A1A16</color>

    <!-- 表面三级亮度（质感层）：底 #15181E / 卡 #1E232B / 内嵌 #141920 -->
    <color name="md_background">#FF15181E</color>
    <color name="md_on_background">#FFF7F8F8</color>
    <color name="md_surface">#FF1E232B</color>
    <color name="md_on_surface">#FFF7F8F8</color>
    <color name="md_surface_variant">#FF141920</color>
    <color name="md_on_surface_variant">#FF8A8F98</color>
    <!-- 暗色边缘：白色 8%（不再用阴影，靠亮度差分层） -->
    <color name="md_outline">#14FFFFFF</color>

    <color name="state_error">#FFF97066</color>
    <color name="state_idle">#FF7C848C</color>

    <color name="card_stroke">#14FFFFFF</color>
    <color name="card_stroke_spread">#09FFFFFF</color>
    <color name="nav_pill_shine">#3DFFFFFF</color>
    <color name="miuix_bg">@color/md_background</color>
    <color name="miuix_card">@color/md_surface</color>
    <color name="miuix_text">@color/md_on_background</color>
    <color name="miuix_text_secondary">@color/md_on_surface_variant</color>
    <color name="miuix_text_tertiary">#FF6B7075</color>
    <color name="miuix_divider">@color/md_outline</color>
    <color name="miuix_stroke">@color/card_stroke</color>
    <color name="miuix_danger">@color/state_error</color>

    <color name="ball_text">#FFEDEDED</color>
    <color name="ball_stroke">#33FFFFFF</color>
    <!-- v223.15 MIUI 快捷球：深色下的外沿柔光（黑底上投影看不见，改用淡白） -->
    <color name="ball_halo">#1FFFFFFF</color>

    <!--
      快捷键模板色板（vXXX）深色覆盖：终端石墨 #5B6470 与表格墨绿 #1E9E5A
      在深色底上偏暗（做标题与芯片文字会糊进背景），这里换成同色系的可读值。
    -->
    <color name="hotkey_tpl_term">#FFAEB6C2</color>
    <color name="hotkey_tpl_sheet">#FF35C98A</color>

    <!-- 悬浮球仿玻璃（v223.22）：overlay 窗口拿不到下层画面，真模糊做不了，用渐变+高光近似 -->
    <color name="ball_glass_top">#CC26262A</color>
    <color name="ball_glass_bottom">#8C1C1C1E</color>
    <color name="ball_glass_hi">#40FFFFFF</color>

    <!-- 浮层语义色（深色）：与 values/colors.xml 同名覆盖 -->
    <color name="overlay_accent">#FF5E8FFF</color>
    <color name="overlay_on_accent">#FF0B0D12</color>
    <color name="overlay_muted">#FF9AA1AC</color>
    <color name="overlay_danger">#FFF97066</color>

    <!-- 手柄页固定深色：与 values 同值（刻意不翻转，见 values/colors.xml 注释）；底色对齐质感层 #15181E -->
    <color name="overlay_scrim">#FF15181E</color>
    <color name="overlay_pad_text">#FFEAEAEA</color>
    <color name="overlay_pad_text_dim">#FFB9BDC7</color>
    <color name="overlay_pad_ok">#FF8BD450</color>
    <color name="overlay_pad_warn">#FFFFB44C</color>
    <color name="overlay_pad_key_pressed">#66FFFFFF</color>
    <color name="overlay_pad_key_idle">#2EFFFFFF</color>
    <color name="overlay_pad_stroke_pressed">#DDFFFFFF</color>
    <color name="overlay_pad_stroke_idle">#66FFFFFF</color>

    <!-- 模块状态色（深色）：与 values 同名覆盖 -->
    <color name="module_state_running">#FF3DDC97</color>
    <color name="module_state_pending">#FFFFB454</color>
    <color name="module_state_error">#FFFF7AA8</color>
    <color name="module_state_idle">#FFA8B0BC</color>
</resources>
