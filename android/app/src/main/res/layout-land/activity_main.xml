<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · 主控制面（横屏沉浸操控面，v1.19）。
  横屏就是"手机横过来当外设"，所以去掉一切取景框：
    · 顶栏（headerBar）整条隐藏 —— include 仍在，id 保留给代码
    · MIUIX 悬浮底栏（tabBar）整条隐藏 —— 改用四指左右滑切页
  · 通知栏 / 手势条由 MainActivity.applyImmersive() 一并盖掉
    ① 触控板页：与竖屏同模板（上=手势面，下=快捷键条）
    ② 键盘页  ：全键盘铺满整屏
    ③ 状态页 / ④ 设置页：复用竖屏块（无底栏，内容可滚到底）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/contentStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 占位：横屏隐藏，但 id 必须存在（代码统一 findViewById） -->
        <include
            layout="@layout/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ViewFlipper
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 触控板页：与竖屏同模板（上=手势面，下=快捷键条），横屏不再左右分栏 -->
            <LinearLayout
                android:id="@+id/pageTouchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:id="@+id/touchArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/tvTouchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="false"
                        android:text="在此区域滑动控制光标"
                        android:textAppearance="@style/APTextCaption" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/chipSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="常用快捷键"
                        android:textAppearance="@style/APTextSubtitle" />

                    <TextView
                        android:id="@+id/btnScreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="副屏"
                        android:textColor="@color/md_primary"
                        android:textAppearance="@style/APTextCaption" />

                    <TextView
                        android:id="@+id/btnGamepad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="手柄"
                        android:textColor="@color/md_primary"
                        android:textAppearance="@style/APTextCaption" />

                    <TextView
                        android:id="@+id/btnEditChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp"
                        android:text="编辑"
                        android:textColor="@color/md_primary"
                        android:textAppearance="@style/APTextCaption" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chipRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- ② 键盘页：全键盘铺满 -->
            <LinearLayout
                android:id="@+id/pageKeyboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="2dp">

                <LinearLayout
                    android:id="@+id/keyboardBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ③ 状态页 / ④ 设置页（复用块） -->
            <include
                layout="@layout/page_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </ViewFlipper>

        <!-- 占位：横屏隐藏（id 必须存在，用于玻璃底栏与页签逻辑） -->
        <include
            layout="@layout/nav_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
