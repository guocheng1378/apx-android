<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 卡片：16dp 圆角白卡 + 极浅描边（对齐 miuix CardDefaults.CornerRadius=16dp） -->
    <style name="APCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- 低强调卡片（说明性内容，16dp 圆角对齐 miuix） -->
    <style name="APCardFlat">
        <item name="android:background">@drawable/bg_card_flat</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- 文本层级 -->
    <style name="APTextTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_on_background</item>
    </style>

    <style name="APTextSubtitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="APTextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="APTextCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <!-- 次按钮：MIUIX 胶囊描边（蓝字细描边） -->
    <!--
      真机反馈（issue #52 第 10 条）「部分按钮内文字没有居中对齐」：
      原样式只给了 padding、没给 gravity —— framework 的 Button 默认 gravity 是
      `left|center_vertical`，短文字看着还行，多字或带上下内边距时文字就贴左，
      视觉上正是「没居中」。这里显式居中，一次修掉整仓用该样式的按钮。
      顺带补 minHeight 48dp（45dp 是可点面积下限；pad 上手指更大，48dp 更稳）。
    -->
    <style name="APButtonGhost">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">?attr/apPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      传输开关按钮（无线 / 蓝牙 / USB）：胶囊描边，点一下开/关。
      选中态（= 该类传输已开）由代码改造成实底 + onPrimary 文字，
      未选中保持中性描边 —— 不用 Switch，省掉「标签 + 开关」两列。
    -->
    <style name="APTransportButton" parent="@style/APButtonGhost">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 状态徽章：胶囊（底色浅，文字由代码按语义色着色） -->
    <style name="APBadge">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/state_ok</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <!-- 分区标题：主色小标题（触控板 / 状态 / 设置） -->
    <style name="APSectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/apPrimary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!--
      分组卡表头（v223）：分组标题从「卡外的主色小标题」搬进卡内。
      设置页右栏只有屏幕 2/3（竖屏 ≈190dp），卡外标题 + 卡本身两段留白把窄列切得很碎，
      进卡后「一张卡 = 一个分组」一眼可辨，纵向每分组还省下 ~28dp。
      刻意不加起始内缩：设置行与说明行都以卡片 16dp 内边距为基准，表头跟着对齐，
      标题、说明、行标题三处同一条竖线（代码渲染的行原先另缩 4dp，这次一并收回）。
    -->
    <style name="APGroupTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 分组表头与卡内首行之间的发丝线（与卡内既有行分隔线同一支：1dp card_stroke） -->
    <!-- 卡内列表行之间的发丝线（分类列表）：与 APGroupDivider 同一支色，但不带额外上边距 ——
         行本身已有 12dp 上下留白，线落在正中间才是均匀的。 -->
    <style name="APListDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/card_stroke</item>
    </style>

    <style name="APGroupDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/space_8</item>
        <item name="android:background">@color/card_stroke</item>
    </style>

    <!--
      设置页行的「说明行」（v223）：行结构统一为「标题（单行）+ 右侧胶囊/箭头」+「说明（整行）」。
      说明独占一行后不再和右侧胶囊抢宽度 —— 长解释（如「方向 / OK / 音量 / 电源」）
      在窄列里才排得开，标题也不必再带着括号折成两三行。
    -->
    <style name="APRowHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:paddingTop">@dimen/space_2</item>
    </style>

    <!--
      文本文本按钮（v1.33）：把「TextView 当按钮用」这件不规范的事补齐规范。
      原先这类入口只有 4dp padding，既够不着 48dp 触控下限、也没有按压反馈、
      不能聚焦（遥控器/键盘 Tab 到不了）、对 TalkBack 是个普通文字节点。
      本样式一次性给出：系统按压涟漪 + 48dp 触控目标 + 可聚焦 + 居中。
      用法：style="@style/APTextButton"，并务必带 android:contentDescription。
    -->
    <style name="APTextButton">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">?attr/apPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
