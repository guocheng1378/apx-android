<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      全局唯一色板：MIUIX / HyperOS 亮色（v1.16 统一）。
      全 App 只有这一套取值 —— 主页、操控面、对话框、副屏浮层都引用这里，
      Kotlin 侧的 MIUIX 令牌常量（TouchpadActivity 的 cAccent 等）与此保持同值。
      旧「深色科技风」色板已废弃（PC 控制面板的深色只留在 PC 端，手机端统一亮色）。

      2026-11-09 界面稿「08 质感层」：
        表面四级 = 背景 #EEF1F5 / 卡片 #FFFFFF / 内嵌面 #FAFBFD / 浮层（毛玻璃，见各浮层组件）；
        边缘 = 1px 内描边 rgba(15,17,20,.07)（= #120F1114）+ 4px 同色外扩 .035；
        暗色不用阴影，改三级亮度差（见 values-night）。
    -->

    <!-- 主色：accent #3482FF（2026-11-09 界面稿全局强调色，取代旧 HyperOS 蓝 #5E6AD2） -->
    <color name="md_primary">#FF3482FF</color>
    <color name="md_on_primary">#FFFFFFFF</color>
    <color name="md_primary_container">#FFE8F1FF</color>
    <!-- 主按钮按下态：比 md_primary 更深一档（bg_btn_primary 的 pressed 分支持它） -->
    <color name="md_primary_pressed">#FF2E72E0</color>

    <color name="md_error_container">#FFFDECEA</color>

    <!-- 表面层级（质感层）：#EEF1F5 底 + 纯白卡片 + #FAFBFD 内嵌面 + 灰阶文字 -->
    <color name="md_background">#FFEEF1F5</color>
    <color name="md_on_background">#FF101113</color>
    <color name="md_surface">#FFFFFFFF</color>
    <color name="md_on_surface">#FF101113</color>
    <!-- 内嵌面（质感层第四级）：卡片里的输入区 / 子块 / 文件行底 -->
    <color name="md_surface_variant">#FFFAFBFD</color>
    <color name="md_on_surface_variant">#FF5C6066</color>
    <!-- 卡片 / 壳 / 胶囊的 1px 内描边：rgba(15,17,20,.07) -->
    <color name="md_outline">#120F1114</color>

    <color name="state_error">#FFF04438</color>
    <!-- 警示橙（遥控器/键盘页的「重启」语义色；旧实现写死 0xFFF0A020，资源化后明暗同值） -->
    <color name="state_warn">#FFF0A020</color>

    <!-- 卡片描边：与 md_outline 同值（1px 内描边 .07；4px 外扩 .035 由各卡的 outline 层叠画） -->
    <color name="card_stroke">#120F1114</color>

    <!--
      触控板页玻璃胶囊（v1.23）顶部的镜面高光；旧底栏的 nav_pill / nav_pill_stroke /
      nav_pill_shade / nav_pill_halo 已随 View 底栏一起删除（现由 Compose 底栏自绘）。
    -->
    <!--
      MIUIX 显式别名（v1.14 引入）：**一律改用 `@color/md_*` 引用**（v1.33）。
      此前是抄一遍同值字面量，等于给漂移留了两个可改点 —— 改 md_* 不会同步到 miuix_*，
      反之亦然。现在别名只是语义入口，取值仍由上面的 md_* / card_* 单点决定。
      保留这些名字是为了让 XML / Kotlin 里能指名道姓地引用语义，不再重复造字面量。
    -->
    <color name="miuix_bg">@color/md_background</color>
    <color name="miuix_card">@color/md_surface</color>
    <color name="miuix_text">@color/md_on_background</color>
    <color name="miuix_text_secondary">@color/md_on_surface_variant</color>
    <!-- 三级文字没有对应的 md_* 令牌（比 variant 更弱的一档），保持独立取值；
         旧值 #BDBDBD 在白卡上几乎读不清，压深到灰蓝族与 on_surface_variant 同族 -->
    <color name="miuix_stroke">@color/card_stroke</color>
    <color name="miuix_danger">@color/state_error</color>

    <!--
      桌面小组件（widget_all_periph）：**刻意固定深色**，不给 values-night 覆盖 —— 小组件贴在任意壁纸上，跟着系统主题翻转反而会出现深壁纸 + 深底、浅壁纸 + 白底
      两头都不稳的情况。写进色板是为了不再散落字面量（值与原实现完全一致）。
    -->
    <color name="widget_bg">#FF1F2228</color>
    <color name="widget_dot">#FF6E747C</color>
    <color name="widget_text">#FF9BA1AA</color>

    <!--
      被控端输入面板（RemoteInputActivity）：这层是**浮在任意应用之上的深色面板**，
      刻意固定深色、不随主题翻转（浅色底面板压在别人画面上更刺眼）。
      此前这些值散在 Kotlin 里用 Color.parseColor 写死，现在集中在此。
    -->
    <color name="remote_panel_bg">#FF1A1A2E</color>
    <color name="remote_panel_field">#FF2A2A3E</color>
    <color name="remote_panel_on">#FFFFFFFF</color>
    <color name="remote_panel_text_dim">#99FFFFFF</color>
    <color name="remote_panel_text_faint">#66FFFFFF</color>

    <!-- 桌面小组件：连接正常时的状态色（与 widget_text/widget_dot 同组） -->
    <color name="widget_ok">#FF34D399</color>

    <color name="ball_text">#CC000000</color>
    <color name="ball_stroke">#33000000</color>
    <!-- v223.15 MIUI 快捷球：球身外一圈极淡柔光（overlay 无父容器，elevation 画不出阴影） -->
    <color name="ball_halo">#0F000000</color>
    <!-- issue#168 二轮：照片卡「待发数量」角标底（半透明黑胶囊，白字在上） -->
    <color name="ball_badge">#B3000000</color>

    <!--
      快捷键模板色板（vXXX）：模板色此前内联在 `hid/HotkeyTemplates.kt` 里，
      深色背景下偏暗的两档（终端石墨 / 表格墨绿）在 values-night 覆盖成可读值。
      模板色是**场景识别色**，不是语义色，因此单独成组而不是塞进 md_* / state_*。
    -->
    <color name="hotkey_tpl_office">#FF3482FF</color>   <!-- 办公通用 -->
    <color name="hotkey_tpl_ai">#FF7C5CFF</color>   <!-- AI 对话 -->
    <color name="hotkey_tpl_code">#FF00A870</color>   <!-- 编程开发 -->
    <color name="hotkey_tpl_video">#FFFF7A00</color>   <!-- 视频剪辑 -->
    <color name="hotkey_tpl_slide">#FFE0457B</color>   <!-- 演示放映 -->
    <color name="hotkey_tpl_design">#FF12B0C8</color>   <!-- 设计制图 -->
    <color name="hotkey_tpl_browser">#FF3B6FF5</color>   <!-- 浏览网页 -->
    <color name="hotkey_tpl_chat">#FF00B96B</color>   <!-- 聊天社交 -->
    <color name="hotkey_tpl_term">#FF5B6470</color>   <!-- 终端运维 -->
    <color name="hotkey_tpl_sheet">#FF1E9E5A</color>   <!-- 表格数据 -->
    <color name="hotkey_tpl_tv">#FFE0457B</color>   <!-- TV 遥控 -->

    <!-- 球身纯色（v223.29.51 起）：球面玻璃渐变/高光已按用户反馈去掉（bg_floating_ball）；
         ball_glass_top/bottom 仍被停靠条与菜单项背景（bg_ball_dock / bg_ball_item）引用，
         高光 ball_glass_hi 已随高光一并移除 -->
    <color name="ball_solid">#CCFFFFFF</color>
    <color name="ball_glass_top">#CCFFFFFF</color>
    <color name="ball_glass_bottom">#8CFFFFFF</color>

    <!--
      浮层语义色（2026-11-07「写死色值收编」）：FilePanel / Gamepad / StatusPage 此前在
      Kotlin 里直接写 `Color(0x…)`，换肤与深浅色都不跟。现在一律走这里，values-night 给深色取值。
      判红规则见 scripts/check_appearance.py 第 6 条；分层选型见 docs/ui-overlay-rules.md。
    -->
    <color name="overlay_accent">#FF3482FF</color>
    <color name="overlay_on_accent">#FFFFFFFF</color>
    <color name="overlay_muted">#FF6B7280</color>
    <color name="overlay_danger">#FFD32F2F</color>

    <!--
      手柄页（GamepadActivity）刻意固定深色：整页是一块全屏手柄面，跟着浅色主题翻白会
      让按键与摇杆失去对比。values-night 与 values 取同值 —— 这不是漏改，见
      docs/ui-overlay-rules.md「仓库特例」。要改成跟随主题，只需删掉 values-night 里
      对应那几行。
    -->
    <color name="overlay_scrim">#FF14161B</color>
    <color name="overlay_pad_text">#FFEAEAEA</color>
    <color name="overlay_pad_text_dim">#FFB9BDC7</color>
    <color name="overlay_pad_ok">#FF8BD450</color>
    <color name="overlay_pad_warn">#FFFFB44C</color>
    <color name="overlay_pad_key_pressed">#66FFFFFF</color>
    <color name="overlay_pad_key_idle">#2EFFFFFF</color>
    <color name="overlay_pad_stroke_pressed">#DDFFFFFF</color>
    <color name="overlay_pad_stroke_idle">#66FFFFFF</color>
    <!-- 摇杆本体配色（issue#169 #17 重写）：圆底 / 描边 / 摇杆头，与旧 JoystickView 一致；
         手柄页固定深色，与 values 同值（见 overlay_scrim 注释）。 -->
    <color name="overlay_stick_base">#22FFFFFF</color>
    <color name="overlay_stick_ring">#55FFFFFF</color>
    <color name="overlay_stick_knob">#DDFFFFFF</color>

    <!--
      模块状态色（StatusPage）：浅色取值，深色在 values-night 覆盖。
      以「卡片底色 + 同色 14% 胶囊底」为最坏情形取值，六个组合全部 ≥4.5:1（表见
      StatusPage.stateColor 的 KDoc）。改色值时请连那张表一起改。
    -->
    <color name="module_state_running">#FF00734D</color>
    <color name="module_state_pending">#FFA34A08</color>
    <color name="module_state_error">#FFB4235A</color>
    <color name="module_state_idle">#FF5B6470</color>
    <color name="keycap_rgb_black">#FF0C0C0C</color>
    <!-- 离线语音面板的透明底暗化层（v223.29.60）：60% 黑，透出背后键盘面板 -->
    <color name="voice_scrim">#99000000</color>
</resources>
