<?xml version="1.0" encoding="utf-8"?>
<!--
  莫奈取色叠加层（issue #52 建议 3）：把 4 个强调色属性指到系统壁纸取色。

  取色源是 androidx material3 同一套：values-v31 的 mc3_primary_* 就是
  `@android:color/system_accent1_*`，色阶下标 = 1000 - Material tone × 10
  （tone 90 → _100、tone 80 → _200、tone 10 → _900，靠 material3 源码核过）。
  所以亮色 primary 取 tone 40 → system_accent1_600，深色 primary 取 tone 80 → _200。

  应用方式：ApPalette.applyRuntimeTheme() 里 `theme.applyStyle(APMonetOverlay, true)`，
  只叠加不替换 —— 其余令牌（surface / outline / error…）仍走 md_*，不会把界面搞花。
-->
<resources>
    <style name="APMonetOverlay" parent="">
        <item name="apPrimary">@android:color/system_accent1_600</item>
        <item name="apPrimaryPressed">@android:color/system_accent1_700</item>
        <item name="apPrimaryContainer">@android:color/system_accent1_100</item>
        <item name="apOnPrimary">@android:color/system_accent1_0</item>
        <!-- framework 自己的强调色也跟着走，否则 AlertDialog 按钮、复选框还是品牌蓝 -->
        <item name="android:colorAccent">@android:color/system_accent1_600</item>
        <item name="android:colorPrimary">@android:color/system_accent1_600</item>
    </style>
</resources>
