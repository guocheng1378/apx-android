<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮球功能菜单（issue #52 建议 2）：单击悬浮球展开这一列，不再直接展开触控板面板。

  报障者原话的功能清单：连接模式（无线 / 蓝牙 / USB，方便切换）、扫描局域网 IP、
  切换连接设备、文件互传、退出 app。

  ⚠️ 配色一律走 @color/md_* 令牌（同 view_floating_ball 与 view_touchpad_panel）：
  服务自带上下文是亮色的，深色模式下写死颜色会「黑字压深底」——issue#44 踩过。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="6dp"
    android:minWidth="176dp"
    android:orientation="vertical"
    android:padding="@dimen/space_8">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_6"
        android:text="@string/ui_ball_menu_connect_mode"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModeWifi"
            style="@style/APTextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="44dp"
            android:text="@string/ui_ball_menu_wifi" />

        <TextView
            android:id="@+id/btnModeBt"
            style="@style/APTextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="44dp"
            android:text="@string/ui_ball_menu_bt" />

        <TextView
            android:id="@+id/btnModeUsb"
            style="@style/APTextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="44dp"
            android:text="@string/ui_ball_menu_usb" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_6"
        android:background="@color/md_outline" />

    <TextView
        android:id="@+id/btnMenuTouchpad"
        style="@style/APTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/ui_main_item_touchpad" />

    <TextView
        android:id="@+id/btnMenuDevices"
        style="@style/APTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/ui_ball_menu_devices" />

    <TextView
        android:id="@+id/btnMenuFiles"
        style="@style/APTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/ui_ball_menu_files" />

    <TextView
        android:id="@+id/btnMenuQuit"
        style="@style/APTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/ui_ball_menu_quit" />

</LinearLayout>