<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏（复用块）：页名 + 副说明 + 全局状态徽章。
  两种朝向都显示（v223.13 起横屏不再走沉浸操控面：顶栏 + 底栏常驻，见 issue #52 建议 4）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_8">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 批D：单行+省略，右侧拥挤时永不逐字竖排（issue#43 图1） -->
        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/ui_main_item_touchpad"
            android:textAppearance="@style/APTextTitle"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvPageSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingTop="@dimen/space_4"
            android:singleLine="true"
            android:textAppearance="@style/APTextCaption" />
    </LinearLayout>

    <TextView
        android:id="@+id/badgeStatus"
        style="@style/APBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_unknown" />

    <!-- 方向锁定快捷开关（竖屏可见；横屏 header 隐藏，由设置页开关承接） -->
    <TextView
        android:id="@+id/btnOrientLock"
        style="@style/APTextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:text="@string/ui_main_btn_orient_lock"
        android:contentDescription="@string/ui_main_cd_orient_lock" />

    <!-- 设置入口常驻右上角（反馈#2）：任何页面一点即达 -->
    <TextView
        android:id="@+id/btnSettingsEntry"
        style="@style/APTextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:text="@string/ui_main_btn_settings_entry"
        android:contentDescription="@string/ui_main_btn_settings_entry" />
</LinearLayout>
