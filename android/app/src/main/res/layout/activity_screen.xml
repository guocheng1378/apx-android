<?xml version="1.0" encoding="utf-8"?>
<!-- 副屏全屏：Surface 容器 + 悬浮状态条（秒退 by 双击悬浮条） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_render">

    <!-- SurfaceView 由 VideoSurfaceView（com.allperiph.screen）以代码方式加入此容器 -->
    <FrameLayout
        android:id="@+id/surfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_overlay_pill"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_waiting"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTouch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
