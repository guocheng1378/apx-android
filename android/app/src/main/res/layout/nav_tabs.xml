<?xml version="1.0" encoding="utf-8"?>
<!--
  MIUIX 悬浮底栏（复用块，v1.21）：**无底板** —— 背景由代码挂 NavBarDrawable（bare = true），
  只画选中胶囊；不再有白色胶囊底与 elevation 投影，图标 / 文字直接落在页面背景上。
  每个页签 = 外层可点容器（weight 均分）+ 内层"选中胶囊"（位置由 Drawable 按选中态滑动）。
  两种朝向都常驻（v223.13 起横屏保留底栏，四指滑切页降级为附加路径）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/space_16"
    android:layout_marginEnd="@dimen/space_16"
    android:layout_marginBottom="@dimen/space_6"
    android:orientation="horizontal"
    android:padding="@dimen/space_6">

    <LinearLayout
        android:id="@+id/tabTouchpad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabPillTouchpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_6">

            <ImageView
                android:id="@+id/ivTabTouchpad"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apx_touchpad" />

            <TextView
                android:id="@+id/tvTabTouchpad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/ui_main_item_touchpad"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabKeyboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabPillKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_6">

            <ImageView
                android:id="@+id/ivTabKeyboard"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apx_keyboard" />

            <TextView
                android:id="@+id/tvTabKeyboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/ui_touchpad_label_keyboard"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabPillSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_6">

            <ImageView
                android:id="@+id/ivTabSettings"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apx_settings" />

            <TextView
                android:id="@+id/tvTabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/section_settings"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
