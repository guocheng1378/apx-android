<?xml version="1.0" encoding="utf-8"?>
<!--
  状态页（复用块）：大号启动开关；**启动后**才展开运行摘要 / 链路诊断 / 延迟预算。
  竖屏底部留 96dp 给悬浮底栏；横屏（layout-land）由外层覆盖为 16dp。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageStatus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- 大号启动开关：整卡都是状态显示，右侧开关放大到易点区域 -->
        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:id="@+id/tvOverall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/common_off"
                android:textColor="@color/md_on_background"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverallSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/common_unknown"
                android:textAppearance="@style/APTextCaption" />

            <!-- 三个传输开关（取代单总开关）：打开即启用该类下全部功能 -->
            <LinearLayout
                android:id="@+id/rowsTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="无线"
                        android:textAppearance="@style/APTextSubtitle" />

                    <Switch
                        android:id="@+id/swWifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="蓝牙"
                        android:textAppearance="@style/APTextSubtitle" />

                    <Switch
                        android:id="@+id/swBt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="USB"
                        android:textAppearance="@style/APTextSubtitle" />

                    <Switch
                        android:id="@+id/swUsb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvIdleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="@string/hint_idle"
            android:textAppearance="@style/APTextCaption" />

        <!-- 未启动时的功能说明：打开开关前先让用户知道能得到什么（启动后自动隐藏） -->
        <LinearLayout
            android:id="@+id/boxIdleFeatures"
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已实现"
                android:textAppearance="@style/APTextSubtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="触控板 —— 手机当鼠标：滑动控光标，轻点左键、双指右键、长按拖选"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="键盘 —— 8 套布局（快捷 / 遥控 / 游戏 / 数字 / 九宫格 / 方向 / F 区 / 自定义）；插线与 Wi‑Fi 两种接法，PC 都免驱识别为键盘"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="常用快捷键 —— 多套场景模板一键铺开，可拖拽排序、长按按住不放"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="多媒体 —— 音量增减、播放暂停、上一首 / 下一首"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="麦克风 —— UAC2 音频，把手机麦克风上行给 PC"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="音响 —— UAC2 音频，把 PC 声音下行到手机扬声器"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="蓝牙 HID（鼠标 / 多媒体）—— PC 自带蓝牙时，不插线也能当鼠标、控制播放"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="Wi‑Fi 控制 —— 电脑没有蓝牙也能用：同一局域网下，PC 端「全能外设」自动发现手机，触控板 / 键盘 / 快捷键直接生效"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:text="尚未接通（计划中）"
                android:textAppearance="@style/APTextSubtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="蓝牙键盘 —— 蓝牙 HID 目前只有鼠标 / 多媒体，键盘待接入（走 Wi‑Fi 控制时键盘已可用）"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="传感器 —— IMU / 光感 / 气压等数据上行给 PC"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="GPS 定位 —— NMEA 经由 CDC ACM 串口上行"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="振动 / 手电 / 红外 —— 由 PC 反向控制手机"
                android:textAppearance="@style/APTextCaption" />
        </LinearLayout>

        <!-- 三步上手：开启后用户经常不知道下一步，这里给固定引导（常显，方便随时回看） -->
        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="怎么用（三步）"
                android:textAppearance="@style/APTextSubtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="① 手机：打开本页上方开关。插数据线时 PC 的 USB 会短暂断开重连，属正常现象"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="② PC：安装并打开「全能外设」（开始菜单里），它会自动发现同一局域网内的手机"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="③ 使用：不插线时在手机侧打开「Wi‑Fi 控制」模块，触控板 / 键盘 / 快捷键随即生效；麦克风与音响走 USB，需插线并开启对应模块"
                android:textAppearance="@style/APTextCaption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/APCardFlat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="运行摘要"
                    android:textAppearance="@style/APTextSubtitle" />

                <TextView
                    android:id="@+id/tvRunningSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/common_unknown"
                    android:textAppearance="@style/APTextCaption" />
            </LinearLayout>

            <!-- 链路诊断 -->
            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_link"
                    android:textAppearance="@style/APTextSubtitle" />

                <LinearLayout
                    android:id="@+id/rowsLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp" />

                <TextView
                    android:id="@+id/tvLinkRtt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/label_link_rt"
                    android:textAppearance="@style/APTextCaption" />
            </LinearLayout>

            <!-- 延迟预算说明（MS4 目标 ≤30ms） -->
            <LinearLayout
                style="@style/APCardFlat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/latency_budget_title"
                    android:textAppearance="@style/APTextSubtitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/latency_budget_body"
                    android:textAppearance="@style/APTextCaption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
