<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · 主控制面（竖屏，v1.19）。
  结构：顶栏（复用块 header_bar）+ 四页 ViewFlipper + MIUIX 液态悬浮底栏（复用块 nav_tabs）。
  v223.13 起**没有** res/layout-land/ 版本：横屏保持同一套顶栏 + 底栏（issue #52 建议 4），
  触控板页的左右分栏由 TouchpadSplit 在运行时重排（旋屏不重建 Activity，本就不吃 layout-land）。
  公共块抽成独立文件，两种朝向共用同一批 id，代码侧 findViewById 无需分支。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <!-- 内容层：整高（内容可从悬浮底栏下穿过，玻璃才有东西可糊） -->
    <LinearLayout
        android:id="@+id/contentStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            layout="@layout/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ViewFlipper
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 触控板页：上=顶部操作（文件/剪贴板），中=手势面，下=常用快捷键条（底部留 88dp 给悬浮底栏） -->
            <LinearLayout
                android:id="@+id/pageTouchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/inset_bottom_nav">

                <!-- v1.8：文件发送 / 剪贴板 —— 从设置页提到触控板顶部，随手可达。
                     按钮由 TouchpadFragment.ensureViews 按 id 绑定（寄生 Fragment 无自身视图树）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_4">

                    <TextView
                        android:id="@+id/btnFileSend"
                        style="@style/APTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_touchpad_text_file"
                        android:contentDescription="@string/ui_main_label_file_send" />

                    <TextView
                        android:id="@+id/btnClipSend"
                        style="@style/APTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:text="@string/ui_touchpad_text_clipboard"
                        android:contentDescription="@string/ui_touchpad_text_clipboard" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/touchArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/tvTouchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="false"
                        android:text="@string/ui_touchpad_text_cursor_swipe"
                        android:textAppearance="@style/APTextCaption" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/chipSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_touchpad_text_hotkey"
                        android:textAppearance="@style/APTextSubtitle" />

                    <TextView
                        android:id="@+id/btnScreen"
                        style="@style/APTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notify_action_screen"
                        android:contentDescription="@string/lay_main_cd_screen_open" />

                    <TextView
                        android:id="@+id/btnGamepad"
                        style="@style/APTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_main_text_gamepad"
                        android:contentDescription="@string/lay_main_cd_gamepad_open" />

                    <TextView
                        android:id="@+id/btnRemote"
                        style="@style/APTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_remote_text_remote"
                        android:contentDescription="@string/lay_main_cd_remote_open" />

                    <TextView
                        android:id="@+id/btnEditChips"
                        style="@style/APTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_common_edit"
                        android:contentDescription="@string/lay_main_cd_hotkey" />
                </LinearLayout>

                <!-- 快捷键网格：竖屏每行 4 个（两行装 8 个），由代码按朝向分行。
                     限高滚动 —— 条目再多也不会把上面的触摸区挤没（100dp ≈ 两行） -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chipRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- ② 键盘页（KeyboardPanels 运行时填充；底部留 88dp 给悬浮底栏） -->
            <LinearLayout
                android:id="@+id/pageKeyboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/inset_bottom_nav">

                <LinearLayout
                    android:id="@+id/keyboardBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ④ 设置页（状态页已并入设置顶，反馈#10） -->
            <include
                layout="@layout/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </ViewFlipper>
    </LinearLayout>

    <!-- MIUIX 液态悬浮底栏 -->
    <include
        layout="@layout/nav_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!--
      批P：横屏操作条 pill——触控板/键盘切换 + 方向锁 + 设置。
      ⚠️ 为什么竖屏布局里也要有：MainActivity 的 configChanges 含 orientation，**旋屏不重建
      Activity**（也就不会加载 layout-land）—— 横屏那棵树其实还是这份竖屏布局。此前 pill 只
      写在 layout-land，于是「竖屏启动→转横屏」根本没有这条 pill，用户反馈「横屏键盘没有方向
      锁定和切换触摸板/键盘按键」。默认 gone，显隐由 MainActivity.applyOrientationLayout()
      按朝向设；layout-land 里也保留一份，冷启动即横屏时同样可用。
    -->
    <LinearLayout
        android:id="@+id/pillLandActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnLandTouchpad"
            style="@style/APTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_6"
            android:text="@string/ui_main_item_touchpad" />

        <TextView
            android:id="@+id/btnLandKeyboard"
            style="@style/APTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:text="@string/ui_touchpad_label_keyboard" />

        <TextView
            android:id="@+id/btnLandLock"
            style="@style/APTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:text="@string/ui_main_btn_orient_lock" />

        <TextView
            android:id="@+id/btnLandSettings"
            style="@style/APTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_8"
            android:text="@string/ui_main_btn_settings_entry" />
    </LinearLayout>

    <!-- 横屏沉浸右上角悬浮设置入口（反馈#2）：横屏 chrome 全隐时的常驻入口 -->
    <TextView
        android:id="@+id/btnSettingsFloat"
        style="@style/APTextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:text="@string/ui_main_btn_settings_entry"
        android:visibility="gone" />
</FrameLayout>