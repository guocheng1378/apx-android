<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android TV 横幅：320x180，纯色底 + 简易标识，构建与展示均可用 -->
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F6FEB" />
        </shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="center_vertical|start"
        android:left="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6EDF3" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
