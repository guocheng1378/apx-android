<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV 服务端深色主题：大字号、高对比，适配远距离观看与老设备 -->
    <!-- 卡片：大字号、可聚焦、选中高亮（DPAD / 点击通用） -->
    <style name="TvCard" parent="android:Widget.TextView">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">140dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">#C9D1D9</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Theme.ApxTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#0B0F14</item>
        <item name="android:colorForeground">#E6EDF3</item>
        <item name="android:windowBackground">#0B0F14</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColor">#E6EDF3</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
