<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      TV 主题：手机端同一套设计令牌的暗色变体。
      大字号、高对比是坐远看的需求，但取值一律来自 colors.xml，不再内联 hex。

      字号层级不在这里定义：TV 界面全部由代码构建（TvUi.applyTextSize），
      层级统一由 TvUi.Type 的命名档位给出 —— 与手机端 20/15/14/12 同比例。
    -->
    <style name="Theme.ApxTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/tv_bg</item>
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:colorPrimary">@color/tv_accent</item>
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="android:colorForeground">@color/tv_text</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
