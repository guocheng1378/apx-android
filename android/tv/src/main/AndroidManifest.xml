<?xml version="1.0" encoding="utf-8"?>
<!--
  APX TV 服务端 Manifest
  namespace: com.allperiph.tv
  设计要点：minSdk=23，不引用 23 之后才引入的 API；声明 leanback（required=false）
  以便同时出现在电视主页与手机上；横幅 banner 供 Android TV 主页展示。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 局域网 TCP 控制面（ServerSocket + UDP 信标） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 全局光标浮层（被控端可视化手机光标） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 读前台 App 窗口内容，供无障碍注入文本/点击 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 前台服务保活（API 28+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型：connectedDevice（API 34 必须显式声明对应权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- connectedDevice 类型的前台服务要求至少声明一项网络/外设权限，本机是局域网控制面服务端 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 开机自启：客厅里的电视/盒子要长期在线（用户开过一次后自动恢复） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 通知（API 33+ runtime） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 电视特性：声明 leanback 但非强制，使 APK 同时能在手机/盒子上安装 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- 无触屏也可运行（遥控器/网络光标驱动） -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_tv"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApxTv"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@style/Theme.ApxTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV 主页入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 副屏页：电脑画面投到电视（9502 媒体通道，等比自适应 + 过扫描安全边距） -->
        <activity
            android:name=".ui.TvScreenActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@style/Theme.ApxTv" />

        <!-- 文件传输面板：看「收到的文件」并发送给对端（遥控器友好、尺寸自适应） -->
        <activity
            android:name=".ui.TvFileActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@style/Theme.ApxTv" />

        <service
            android:name=".TvServerService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 系统级输入注入（手机遥控手机 / 电视） -->
        <service
            android:name=".core.ApxAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机 / 应用更新后自动拉起被控服务（用户开过一次即视为启用，见 MainActivity） -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
